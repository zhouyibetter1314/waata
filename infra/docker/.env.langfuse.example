# Copy to .env.langfuse and replace each replace_me value with a different random hex string.
# ENCRYPTION_KEY requires exactly 64 hex digits (openssl rand -hex 32).
NEXTAUTH_URL=http://127.0.0.1:13038
NEXTAUTH_SECRET=replace_me
SALT=replace_me
ENCRYPTION_KEY=replace_me
TELEMETRY_ENABLED=false

POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres
REDIS_AUTH=replace_me
CLICKHOUSE_PASSWORD=replace_me

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace_me
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=${MINIO_ROOT_USER}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=${MINIO_ROOT_USER}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://127.0.0.1:9090
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=${MINIO_ROOT_USER}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://127.0.0.1:9090
