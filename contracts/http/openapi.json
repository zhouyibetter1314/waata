{
  "openapi": "3.1.0",
  "info": {
    "title": "WAATA Test Runs API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/test-runs": {
      "post": {
        "tags": [
          "test-runs"
        ],
        "summary": "Create Run",
        "operationId": "create_test_run",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            }
          },
          "400": {
            "description": "请求格式无法解析",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "测试目标或凭据引用未获授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "请求字段无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "请求处理失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "队列暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "test-runs"
        ],
        "summary": "List Runs",
        "operationId": "list_test_runs",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "请求字段无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "请求处理失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test-runs/{run_id}": {
      "get": {
        "tags": [
          "test-runs"
        ],
        "summary": "Get Run",
        "operationId": "get_test_run",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetail"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在或对调用方不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "请求处理失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "properties": {
          "target_url": {
            "type": "string",
            "format": "uri",
            "title": "Target Url"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "title": "Goal"
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1,
            "title": "Expected Behavior"
          },
          "credential_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Ref"
          },
          "options": {
            "$ref": "#/components/schemas/RunOptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_url",
          "goal",
          "expected_behavior"
        ],
        "title": "CreateRunRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunAccepted": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "created_at"
        ],
        "title": "RunAccepted"
      },
      "RunCaseSummary": {
        "properties": {
          "passed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Passed"
          },
          "failed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Failed"
          },
          "blocked": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Blocked"
          },
          "inconclusive": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Inconclusive"
          }
        },
        "type": "object",
        "required": [
          "passed",
          "failed",
          "blocked",
          "inconclusive"
        ],
        "title": "RunCaseSummary"
      },
      "RunDetail": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "goal": {
            "type": "string",
            "title": "Goal"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "errored",
              "cancelled"
            ],
            "title": "Status"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "inconclusive"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "expected_behavior": {
            "type": "string",
            "title": "Expected Behavior"
          },
          "progress": {
            "$ref": "#/components/schemas/RunProgress"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunCaseSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunError"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancellation_requested": {
            "type": "boolean",
            "title": "Cancellation Requested"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "target_url",
          "goal",
          "status",
          "verdict",
          "created_at",
          "started_at",
          "finished_at",
          "expected_behavior",
          "progress",
          "summary",
          "error",
          "cancellation_requested"
        ],
        "title": "RunDetail"
      },
      "RunError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "RunError"
      },
      "RunOptions": {
        "properties": {
          "headless": {
            "type": "boolean",
            "title": "Headless",
            "default": true
          },
          "max_steps_per_case": {
            "type": "integer",
            "maximum": 35.0,
            "minimum": 1.0,
            "title": "Max Steps Per Case",
            "default": 35
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunOptions"
      },
      "RunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "RunPage"
      },
      "RunProgress": {
        "properties": {
          "total_cases": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cases"
          },
          "completed_cases": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completed Cases"
          }
        },
        "type": "object",
        "required": [
          "total_cases",
          "completed_cases"
        ],
        "title": "RunProgress"
      },
      "RunSummary": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "goal": {
            "type": "string",
            "title": "Goal"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "errored",
              "cancelled"
            ],
            "title": "Status"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "inconclusive"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "target_url",
          "goal",
          "status",
          "verdict",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "RunSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "APIKeyCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "waata_dev_session"
      }
    }
  }
}
