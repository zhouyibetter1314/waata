# 模型服务

# OpenAI 兼容 API 的根地址。填写服务商提供的地址，Worker 会拼接 /chat/completions。
WAATA_MODEL_BASE_URL=
# 服务商提供的模型 ID。Worker 使用该值选择支持工具调用的模型。
WAATA_MODEL_NAME=
# 模型服务的访问密钥。服务无需认证时可留空。
WAATA_MODEL_API_KEY=

# Langfuse 运行追踪（可选）

# Langfuse 实例的访问地址。自部署时填写实例的根地址。
LANGFUSE_BASE_URL=
# Langfuse 项目的公钥。启用追踪时与私钥一起配置。
LANGFUSE_PUBLIC_KEY=
# Langfuse 项目的私钥，用于认证追踪数据的上传请求。
LANGFUSE_SECRET_KEY=

# 后端运行

# API 和 Worker 共用的 PostgreSQL 连接串，用于保存任务、事件、报告及证据元数据。
WAATA_DATABASE_DSN=
# API 身份模式。disabled 禁用访问，local 用于本机回环访问，gateway 用于可信网关。
WAATA_AUTH_MODE=disabled
# 目标授权策略 JSON 文件路径，定义可访问的主体、站点、动作和凭据引用。
WAATA_TARGET_POLICY=
# API 和 Worker 共用的私有证据目录，保存截图和结构化观察等文件。
WAATA_ARTIFACT_ROOT=artifacts/platform

# 本地登录验收夹具

# 演示站点接受的登录密码，仅供本地验收使用。
WAATA_DEMO_PASSWORD=
# 用于验证错误提示的错误密码，必须与演示站点接受的密码不同。
WAATA_DEMO_WRONG_PASSWORD=
